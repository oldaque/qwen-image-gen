# =============================================================================
# .env.example — image-gen
#
# Uso:  cp .env.example .env  &&  ${EDITOR:-vi} .env
# O docker-compose.dokploy.yml usa "env_file: .env" — o arquivo e OBRIGATORIO,
# sem ele o stack nao sobe. Nada aqui e secreto por padrao: o default e
# IMAGE_PROVIDER=fake, que gera PNG localmente com Pillow e NAO faz rede.
#
# Convencao: [COMPOSE] = lida pelo docker-compose/docker; as demais sao lidas
# pelo app (app/config.py, pydantic-settings) e valem tambem fora do Docker.
# =============================================================================

# -----------------------------------------------------------------------------
# PROVIDER ATIVO
# -----------------------------------------------------------------------------
# fake         -> PNG sintetico com Pillow, progresso 0..100 em ~3 s, SEM rede.
#                 E o default: o app sobe e funciona sem chave nenhuma.
# fal          -> fal.ai (o qwen-image-2.1 esta disponivel na plataforma).
#                 Pago, sincrono; exige FAL_KEY.
# remote_gpu   -> sua GPU (vLLM-Omni / SGLang-Diffusion), rota OpenAI-compat
#                 /v1/images/generations; exige REMOTE_GPU_URL + REMOTE_GPU_KEY.
# local_comfy  -> ComfyUI no servico "comfy" (profile local do compose).
#                 Numa VM ARM64 sem GPU conte em HORAS por imagem; exige a
#                 imagem arm64 que voce builda (ver COMFY_IMAGE).
# Se o provider escolhido estiver sem configuracao, o POST /api/v1/jobs
# responde 400 na hora (fail fast).
IMAGE_PROVIDER=fake

# -----------------------------------------------------------------------------
# ARMAZENAMENTO (dentro do container o volume "appdata" esta em /data)
# -----------------------------------------------------------------------------
DATA_DIR=/data
DB_PATH=/data/jobs.db
IMAGES_DIR=/data/images

# -----------------------------------------------------------------------------
# FAL (IMAGE_PROVIDER=fal)
# -----------------------------------------------------------------------------
# Chave da API fal.ai. Header enviado: "Authorization: Key $FAL_KEY".
FAL_KEY=
# Modelo de text-to-image. Preco: ~$0.02 por megapixel de saida (1 MP = 1024x1024;
# 2048x2048 = 4.19 MP ~= $0.084; num_images=4 @1024 ~= $0.08 por request).
FAL_MODEL=alibaba/qwen-image-2.1/text-to-image
# Modelo usado quando o job tem reference_images (image_urls ordenados, max 10).
# Preco: ~$0.0367 por megapixel de entrada + de saida.
FAL_EDIT_MODEL=alibaba/qwen-image-2.1/edit

# -----------------------------------------------------------------------------
# COMFYUI (IMAGE_PROVIDER=local_comfy)
# -----------------------------------------------------------------------------
# URL interna do servico "comfy" (DNS do compose). Nao use localhost: o webapp
# roda em outro container. O ComfyUI nao tem auth embutida — mantenha no
# network interno, sem porta publicada.
COMFY_URL=http://comfy:8188

# -----------------------------------------------------------------------------
# GPU REMOTA (IMAGE_PROVIDER=remote_gpu)
# -----------------------------------------------------------------------------
# Endpoint base OpenAI-compat. Ex. de subida: vllm serve Qwen/Qwen-Image-2.1
# --omni --port 8091 -> https://gpu.exemplo.com/v1 (ou http://host:8091/v1).
# VRAM: 48 GB bf16 (A6000/L40S/A100-40GB no limite) ou 16-20 GB quantizado.
REMOTE_GPU_URL=
# Header enviado: "Authorization: Bearer $REMOTE_GPU_KEY".
REMOTE_GPU_KEY=
# Nome do modelo enviado no corpo do request.
REMOTE_GPU_MODEL=Qwen/Qwen-Image-2.1

# -----------------------------------------------------------------------------
# FILA / LIMITES
# -----------------------------------------------------------------------------
# Teto de tempo por job, em segundos (7200 = 2 h). A geracao local em CPU passa
# facil disso em 1024²+: suba para 86400 (24 h) se for usar local_comfy — assim
# ate o pior caso de 2048² (~18 h) cabe.
JOB_TIMEOUT_SECONDS=7200
# Jobs em paralelo. Em ARM CPU sem GPU, 1 e o valor correto: paralelizar so
# troca tempo de parede por thrash de memoria (a RAM disponivel nesse tipo de
# VM e da ordem de 23 GB).
MAX_PARALLEL_JOBS=1

# -----------------------------------------------------------------------------
# IMAGEM / VALIDACAO (defaults dos campos do JobCreate)
# -----------------------------------------------------------------------------
DEFAULT_WIDTH=1024
DEFAULT_HEIGHT=1024
MIN_SIZE=512
MAX_SIZE=2048

# -----------------------------------------------------------------------------
# APP
# -----------------------------------------------------------------------------
# Aparece em GET /api/v1/health e na tag da imagem do compose.
APP_VERSION=0.1.0

# -----------------------------------------------------------------------------
# [COMPOSE] SOMENTE PARA O DOCKER-COMPOSE (o app NAO le esta variavel)
# -----------------------------------------------------------------------------
# Imagem arm64 do ComfyUI para o servico "comfy" (profile "local").
# NAO existe imagem oficial/confiavel para arm64 generico — o valor abaixo e um
# PLACEHOLDER e o serviço nao sobe enquanto voce nao apontar para a imagem que
# buildou (esboco de Dockerfile de ~15 linhas nos comentarios do
# docker-compose.dokploy.yml). So precisa disto se IMAGE_PROVIDER=local_comfy.
COMFY_IMAGE=comfyui-arm64:local-placeholder

# -----------------------------------------------------------------------------
# LICENCA (aviso, nao e variavel)
# -----------------------------------------------------------------------------
# Os pesos do Qwen-Image-2.1 estao sob a Qwen Research License Agreement
# (2026-09-20): uso NAO comercial. Ha caminho de licenca comercial paga em
# model-business@notice.qwencloud.com. Rodar o modelo via FAL/GPU remota nao
# muda a licenca dos pesos que VOCE baixa em scripts/download_models.sh.
